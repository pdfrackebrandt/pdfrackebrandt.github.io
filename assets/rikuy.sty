% rikuy.sty: live figures in Rikuy, pictures everywhere else.
% \rikuywidget[<includegraphics options>]{<widget .html>}{<fallback image>}
% Rikuy's typeset page runs the widget; any TeX compile (Rikuy's PDF, Overleaf, a desktop TeX Live)
% prints the fallback image, or a quiet box if the image is missing.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rikuy}[2026/10/30 v1.0 live figures in Rikuy, pictures elsewhere]
\RequirePackage{graphicx}
\DeclareRobustCommand\rikuywidget[3][]{%
  \IfFileExists{#3}%
    {\includegraphics[#1]{#3}}%
    {\fbox{\parbox{0.9\linewidth}{\centering\small Live figure: open this document in Rikuy to use it.}}}}
\endinput
